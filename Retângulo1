
#include <stdio.h>

int main() {
    float base1, altura1, base2, altura2;
    float area1, area2;

    printf("Digite a base do primeiro retangulo: ");
    scanf("%f", &base1);

    printf("Digite a altura do primeiro retangulo: ");
    scanf("%f", &altura1);

    printf("Digite a base do segundo retangulo: ");
    scanf("%f", &base2);

    printf("Digite a altura do segundo retangulo: ");
    scanf("%f", &altura2);

    area1 = base1 * altura1;
    area2 = base2 * altura2;

    printf("\nArea do primeiro retangulo: %.2f", area1);
    printf("\nArea do segundo retangulo: %.2f", area2);

    if (area1 > area2) {
        printf("\nO primeiro retangulo e maior.");
    } else if (area2 > area1) {
        printf("\nO segundo retangulo e maior.");
    } else {
        printf("\nOs dois retangulos possuem areas iguais.");
    }

    return 0;
}

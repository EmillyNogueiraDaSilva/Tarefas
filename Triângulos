
#include <stdio.h>

int main() {
    float base1, altura1, base2, altura2;
    float area1, area2;

    printf("Digite a base do primeiro triangulo: ");
    scanf("%f", &base1);

    printf("Digite a altura do primeiro triangulo: ");
    scanf("%f", &altura1);

    printf("Digite a base do segundo triangulo: ");
    scanf("%f", &base2);

    printf("Digite a altura do segundo triangulo: ");
    scanf("%f", &altura2);

    area1 = (base1 * altura1) / 2;
    area2 = (base2 * altura2) / 2;

    printf("\nArea do primeiro triangulo: %.2f", area1);
    printf("\nArea do segundo triangulo: %.2f", area2);

    if (area1 > area2) {
        printf("\nO primeiro triangulo e maior.");
    } else if (area2 > area1) {
        printf("\nO segundo triangulo e maior.");
    } else {
        printf("\nOs dois triangulos possuem areas iguais.");
    }

    return 0;
}
